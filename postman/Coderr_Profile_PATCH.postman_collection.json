{
  "info": {
    "name": "Coderr Profile PATCH",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the complete collection in order. Creates two fresh test accounts and uploads local fixture images. Select the four upload files before running. See PROFILE_PATCH.md."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get(\"base_url\") !== \"http://127.0.0.1:8000/api\") {",
          " throw new Error(\"This collection requires the local Coderr backend.\");",
          "}",
          "if (!pm.info.requestName.startsWith(\"PREP |\")) {",
          " [\"customer\",\"business\"].forEach(role => {",
          "  if (!pm.collectionVariables.get(\"patch_\" + role + \"_token\") ||",
          "      !pm.collectionVariables.get(\"patch_\" + role + \"_id\")) {",
          "   throw new Error(\"Run both PREP requests first.\");",
          "  }",
          " });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "PREP | Register customer",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"patch_customer_{{patch_run}}\", \"email\": \"patch_customer_{{patch_run}}@example.com\", \"password\": \"CoderrTest!83_TestOnly\", \"repeated_password\": \"CoderrTest!83_TestOnly\", \"type\": \"customer\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "[\"customer\", \"business\"].forEach(role => {",
              "    pm.collectionVariables.unset(\"patch_\" + role + \"_token\");",
              "    pm.collectionVariables.unset(\"patch_\" + role + \"_id\");",
              "});",
              "pm.collectionVariables.unset(\"patch_snapshot\");",
              "pm.collectionVariables.unset(\"patch_previous_image\");",
              "pm.collectionVariables.set(\"patch_run\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registration returns 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Registration returns credentials and ID\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.all.keys(\"token\", \"username\", \"email\", \"user_id\");",
              "    pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.user_id).to.be.a(\"number\").above(0);",
              "});",
              "if (pm.response.code === 201) {",
              "    const data = pm.response.json();",
              "    pm.collectionVariables.set(\"patch_customer_token\", data.token);",
              "    pm.collectionVariables.set(\"patch_customer_id\", data.user_id);",
              "}"
            ]
          }
        }
      ]
    },

              "});",
              "pm.test(\"Requested values are returned\", () => {",
              "const data = pm.response.json();",
              "pm.expect(data[\"location\"]).to.eql(\"\");",
              "});",
              "",
              "pm.test(\"Other fields are preserved\", () => {",
              " const before = JSON.parse(pm.collectionVariables.get(\"patch_snapshot\"));",
              " const after = pm.response.json();",
              " delete before.location; delete after.location;",
              " pm.expect(after).to.deep.eql(before);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"patch_snapshot\", JSON.stringify(pm.response.json()));",
              "}"
            ]
          }
        }
      ]

    {
      "name": "E04-01 | Update customer texts",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{patch_customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/profile/{{patch_customer_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\"first_name\": \"Bastian\", \"last_name\": \"Example\", \"email\": \"patch_updated@example.com\", \"location\": \"Dortmund\", \"tel\": \"+49 123 456789\", \"description\": \"Web development services.\", \"working_hours\": \"Monday to Friday\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Exact profile fields\", () => {",
              "    pm.expect(pm.response.json()).to.have.all.keys([\"user\", \"username\", \"first_name\", \"last_name\", \"file\", \"location\", \"tel\", \"description\", \"working_hours\", \"type\", \"email\", \"created_at\"]);",
              "});",
              "pm.test(\"Requested values are returned\", () => {",
              "const data = pm.response.json();",
              "pm.expect(data[\"first_name\"]).to.eql(\"Bastian\");",
              "pm.expect(data[\"last_name\"]).to.eql(\"Example\");",
              "pm.expect(data[\"email\"]).to.eql(\"patch_updated@example.com\");",
              "pm.expect(data[\"location\"]).to.eql(\"Dortmund\");",
              "pm.expect(data[\"tel\"]).to.eql(\"+49 123 456789\");",
              "pm.expect(data[\"description\"]).to.eql(\"Web development services.\");",
              "pm.expect(data[\"working_hours\"]).to.eql(\"Monday to Friday\");",
              "pm.expect(data[\"type\"]).to.eql(\"customer\");",
              "pm.expect(data[\"file\"]).to.eql(null);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"patch_snapshot\", JSON.stringify(pm.response.json()));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "E04-02 | Verify saved customer texts",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{patch_customer_token}}"
          }
        ],
        "url": "{{base_url}}/profile/{{patch_customer_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Stored profile is unchanged\", () => {",
              "    const previous = pm.collectionVariables.get(\"patch_snapshot\");",
              "    pm.expect(previous, \"A preceding successful request is required\").to.be.a(\"string\").and.not.empty;",
              "    pm.expect(pm.response.json()).to.deep.eql(JSON.parse(previous));",
              "});"
            ]
          }
        }
      ]
    },

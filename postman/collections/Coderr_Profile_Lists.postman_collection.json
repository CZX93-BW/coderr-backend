{
  "info": {
    "name": "Coderr Profile Lists",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read both role lists as a customer and provider. Check membership, response fields and authentication."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get('base_url') !== 'http://127.0.0.1:8000/api') {",
          " throw new Error('Select Coderr Local with base_url http://127.0.0.1:8000/api');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "PREP | Register customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"lists_customer_{{lists_run}}\",\n  \"email\": \"lists_customer_{{lists_run}}@example.com\",\n  \"password\": \"CoderrTest!83_TestOnly\",\n  \"repeated_password\": \"CoderrTest!83_TestOnly\",\n  \"type\": \"customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['customer','business'].forEach(r => ['token','id','username'].forEach(k => pm.collectionVariables.unset('lists_'+r+'_'+k)));",
              "pm.collectionVariables.set('lists_run', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Registration returns 201', () => pm.response.to.have.status(201));",
              "pm.test('Registration returns documented fields and valid credentials', () => {",
              " pm.expect(data).to.have.all.keys('token','username','email','user_id');",
              " pm.expect(data.token).to.be.a('string').and.match(/^[a-f0-9]{40}$/);",
              " pm.expect(data.user_id).to.be.a('number').and.above(0);",
              "});",
              "if (pm.response.code === 201) {",
              " ['token','username'].forEach(k => pm.collectionVariables.set('lists_customer_'+k, data[k]));",
              " pm.collectionVariables.set('lists_customer_id', data.user_id);",
              "}"
            ]
          }
        }
      ]
    },

    {
      "name": "LIST | customer reads customer profiles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{lists_customer_token}}"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/profiles/customer/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('List returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is an unpaginated array', () => pm.expect(data).to.be.an('array'));",
              "pm.test('Every profile has exactly the documented fields', () => {",
              " pm.expect(data).to.be.an('array');",
              " data.forEach(p => pm.expect(p).to.have.all.keys([\"user\", \"username\", \"first_name\", \"last_name\", \"file\", \"uploaded_at\", \"type\"]));",
              "});",
              "pm.test('Only customer profiles are returned', () => {",
              " pm.expect(data).to.be.an('array');",
              " data.forEach(p => pm.expect(p.type).to.eql('customer'));",
              "});",
              "pm.test('Prepared profile is present exactly once with correct values', () => {",
              " const matches = data.filter(p => p.user === Number(pm.collectionVariables.get('lists_customer_id')));",
              " pm.expect(matches).to.have.lengthOf(1);",
              " const p = matches[0];",
              " pm.expect(p.username).to.eql(pm.collectionVariables.get('lists_customer_username'));",
              " Object.entries({\"first_name\": \"Clara\", \"last_name\": \"Customer\"}).forEach(([key,value]) => pm.expect(p[key], key).to.eql(value));",
              " pm.expect(p.file).to.eql(null);",
              " pm.expect(p.uploaded_at).to.eql(null);",
              "});",
              "pm.test('Prepared opposite role is excluded', () => {",
              " const other = Number(pm.collectionVariables.get('lists_business_id'));",
              " pm.expect(data.map(p => p.user)).not.to.include(other);",
              "});"
            ]
          }
        }
      ]
    },

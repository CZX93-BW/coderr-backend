    {
      "name": "PREP | Set customer profile data",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{lists_customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/profile/{{lists_customer_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Clara\",\n  \"last_name\": \"Customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Profile update returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Prepared profile values are saved', () => {",
              " const expected = {\"first_name\": \"Clara\", \"last_name\": \"Customer\"};",
              " Object.entries(expected).forEach(([key,value]) => pm.expect(data[key], key).to.eql(value));",
              "});"
            ]
          }
        }
      ]
    },

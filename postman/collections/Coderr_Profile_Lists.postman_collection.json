    {
      "name": "AUTH | customer list with no token",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/profiles/customer/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Unauthorized request returns 401', () => pm.response.to.have.status(401));",
              "pm.test('Error contains detail and no profile data', () => {",
              " pm.expect(data).to.be.an('object');",
              " pm.expect(data).to.have.all.keys('detail');",
              " pm.expect(data.detail).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },

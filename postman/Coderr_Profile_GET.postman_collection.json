    {
      "name": "E03-05 | No token",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{base_url}}/profile/{{customer_a_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Error contains a detail message\", () => {",
              "    pm.expect(pm.response.json().detail).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.test(\"No profile or credentials are exposed\", () => {",
              "    const data = pm.response.json();",
              "    [\"user\", \"username\", \"email\", \"token\", \"password\"].forEach(field => {",
              "        pm.expect(data).not.to.have.property(field);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },

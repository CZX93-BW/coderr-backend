  "item": [
    {
      "name": "PREP | Register owner",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"od_owner_{{od_run}}\",\n  \"email\": \"od_owner_{{od_run}}@example.com\",\n  \"type\": \"business\",\n  \"password\": \"CoderrTest!83_TestOnly\",\n  \"repeated_password\": \"CoderrTest!83_TestOnly\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"od_run\", pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\"));",
              "[\"owner\", \"customer\", \"other\"].forEach(role => {",
              "  pm.collectionVariables.unset(\"od_\" + role + \"_token\");",
              "  pm.collectionVariables.unset(\"od_\" + role + \"_id\");",
              "});",
              "[\"od_a\", \"od_b\", \"od_a_id\", \"od_b_id\", \"od_snapshot\"].forEach(key => pm.collectionVariables.unset(key));",
              "[\"basic\", \"standard\", \"premium\"].forEach(kind => {",
              "  pm.collectionVariables.unset(\"od_\" + kind + \"_id\");",
              "  pm.collectionVariables.unset(\"od_\" + kind + \"_url\");",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "const sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
              "pm.test(\"Fresh account credentials match registration\", () => {",
              "  pm.expect(data).to.have.all.keys(\"token\", \"username\", \"email\", \"user_id\");",
              "  pm.expect(data.username).to.eql(sent.username);",
              "  pm.expect(data.email).to.eql(sent.email);",
              "  pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data.user_id).to.be.a(\"number\").and.above(0);",
              "});",
              "if (pm.response.code === 201 && data.token) {",
              "  pm.collectionVariables.set(\"od_owner_token\", data.token);",
              "  pm.collectionVariables.set(\"od_owner_id\", data.user_id);",
              "}"
            ]
          }
        }
      ]
    },

    {
      "name": "E09 | Customer reads foreign offer A and captures package links",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{od_customer_token}}"
          }
        ],
        "url": "{{base_url}}/offers/{{od_a_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "const fixture = JSON.parse(pm.collectionVariables.get(\"od_a\"));",
              "pm.test(\"Exactly the ten documented offer fields\", () => {",
              "  pm.expect(data).to.have.all.keys(\"id\", \"user\", \"title\", \"image\", \"description\",",
              "    \"created_at\", \"updated_at\", \"details\", \"min_price\", \"min_delivery_time\");",
              "});",
              "pm.test(\"Requested offer, owner and independent minima are correct\", () => {",
              "  [\"id\", \"user\", \"title\", \"description\", \"image\"].forEach(key => pm.expect(data[key]).to.eql(fixture[key]));",
              "  pm.expect(data.min_price).to.eql(Math.min(...fixture.details.map(d => d.price)));",
              "  pm.expect(data.min_delivery_time).to.eql(Math.min(...fixture.details.map(d => d.delivery_time_in_days)));",
              "  [data.created_at, data.updated_at].forEach(value => {",
              "    pm.expect(value).to.be.a(\"string\");",
              "    pm.expect(Number.isNaN(Date.parse(value))).to.eql(false);",
              "  });",
              "});",
              "pm.test(\"Only this offer's packages appear, with exact absolute API links\", () => {",
              "  const base = pm.variables.replaceIn(\"{{base_url}}\");",
              "  pm.expect(data.details).to.have.lengthOf(3);",
              "  const expected = fixture.details.map(d => ({id: d.id, url: base + \"/offerdetails/\" + d.id + \"/\"}));",
              "  pm.expect([...data.details].sort((a, b) => a.id - b.id)).to.eql(expected.sort((a, b) => a.id - b.id));",
              "});",
              "",
              "if (pm.response.code === 200 && Array.isArray(data.details)) {",
              "  fixture.details.forEach(package => {",
              "    const link = data.details.find(d => d.id === package.id);",
              "    if (link) pm.collectionVariables.set(\"od_\" + package.offer_type + \"_url\", link.url);",
              "  });",
              "  pm.collectionVariables.set(\"od_snapshot\", JSON.stringify(data));",
              "}"
            ]
          }
        }
      ]
    },

    {
      "name": "PREP | Create offer A",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{od_owner_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/offers/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Detail fixture A {{od_run}}\",\n  \"description\": \"Offer A for authenticated detail retrieval.\",\n  \"image\": null,\n  \"details\": [\n    {\n      \"title\": \"A Basic website\",\n      \"revisions\": -1,\n      \"delivery_time_in_days\": 7,\n      \"price\": 0,\n      \"features\": [\n        \"Responsive layout\",\n        \"A basic feature\"\n      ],\n      \"offer_type\": \"basic\"\n    },\n    {\n      \"title\": \"A Standard website\",\n      \"revisions\": 2,\n      \"delivery_time_in_days\": 0,\n      \"price\": 100.5,\n      \"features\": [\n        \"Responsive layout\",\n        \"A standard feature\"\n      ],\n      \"offer_type\": \"standard\"\n    },\n    {\n      \"title\": \"A Premium website\",\n      \"revisions\": 5,\n      \"delivery_time_in_days\": 3,\n      \"price\": 500,\n      \"features\": [\n        \"Responsive layout\",\n        \"A premium feature\"\n      ],\n      \"offer_type\": \"premium\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "const sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
              "pm.test(\"Offer and all three packages are saved correctly\", () => {",
              "  pm.expect(data).to.have.all.keys(\"id\", \"title\", \"image\", \"description\", \"details\");",
              "  pm.expect(data.id).to.be.a(\"number\").and.above(0);",
              "  pm.expect(data.title).to.eql(sent.title);",
              "  pm.expect(data.description).to.eql(sent.description);",
              "  pm.expect(data.image).to.eql(null);",
              "  pm.expect(data.details).to.have.lengthOf(3);",
              "  pm.expect(data.details.map(d => d.offer_type).sort()).to.eql([\"basic\", \"premium\", \"standard\"]);",
              "  data.details.forEach(detail => {",
              "    pm.expect(detail.id).to.be.a(\"number\").and.above(0);",
              "    const expected = sent.details.find(d => d.offer_type === detail.offer_type);",
              "    pm.expect(detail).to.eql({...expected, id: detail.id});",
              "  });",
              "});",
              "if (pm.response.code === 201 && Array.isArray(data.details)) {",
              "  const fixture = {...sent, id: data.id, user: Number(pm.collectionVariables.get(\"od_owner_id\")),",
              "    details: sent.details.map(detail => ({...detail,",
              "      id: data.details.find(d => d.offer_type === detail.offer_type).id}))};",
              "  pm.collectionVariables.set(\"od_a\", JSON.stringify(fixture));",
              "  pm.collectionVariables.set(\"od_a_id\", data.id);",
              "  if (\"a\" === \"a\") data.details.forEach(d => pm.collectionVariables.set(\"od_\" + d.offer_type + \"_id\", d.id));",
              "}"
            ]
          }
        }
      ]
    },

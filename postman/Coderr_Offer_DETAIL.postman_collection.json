    {
      "name": "REGRESSION | Public list keeps its relative package links",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": "{{base_url}}/offers/?search={{od_run}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Public list still returns 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "const fixtures = [\"a\", \"b\"].map(key => JSON.parse(pm.collectionVariables.get(\"od_\" + key)));",
              "pm.test(\"Run search returns exactly both fixtures\", () => {",
              "  pm.expect(data).to.have.all.keys(\"count\", \"next\", \"previous\", \"results\");",
              "  pm.expect(data.count).to.eql(2);",
              "  pm.expect(data.results.map(o => o.id).sort((a, b) => a - b)).to.eql(fixtures.map(f => f.id).sort((a, b) => a - b));",
              "  pm.expect(data.next).to.eql(null);",
              "  pm.expect(data.previous).to.eql(null);",
              "});",
              "pm.test(\"List package links remain relative without API prefix\", () => {",
              "  data.results.forEach(offer => {",
              "    pm.expect(offer).to.have.all.keys(\"id\", \"user\", \"title\", \"image\", \"description\",",
              "      \"created_at\", \"updated_at\", \"details\", \"min_price\", \"min_delivery_time\", \"user_details\");",
              "    const fixture = fixtures.find(f => f.id === offer.id);",
              "    const expected = fixture.details.map(d => ({id: d.id, url: \"/offerdetails/\" + d.id + \"/\"}));",
              "    pm.expect([...offer.details].sort((a, b) => a.id - b.id)).to.eql(expected.sort((a, b) => a.id - b.id));",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "VERIFY | Offer A remains unchanged after all reads",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{od_customer_token}}"
          }
        ],
        "url": "{{base_url}}/offers/{{od_a_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "const fixture = JSON.parse(pm.collectionVariables.get(\"od_a\"));",
              "pm.test(\"Exactly the ten documented offer fields\", () => {",
              "  pm.expect(data).to.have.all.keys(\"id\", \"user\", \"title\", \"image\", \"description\",",
              "    \"created_at\", \"updated_at\", \"details\", \"min_price\", \"min_delivery_time\");",
              "});",
              "pm.test(\"Requested offer, owner and independent minima are correct\", () => {",
              "  [\"id\", \"user\", \"title\", \"description\", \"image\"].forEach(key => pm.expect(data[key]).to.eql(fixture[key]));",
              "  pm.expect(data.min_price).to.eql(Math.min(...fixture.details.map(d => d.price)));",
              "  pm.expect(data.min_delivery_time).to.eql(Math.min(...fixture.details.map(d => d.delivery_time_in_days)));",
              "  [data.created_at, data.updated_at].forEach(value => {",
              "    pm.expect(value).to.be.a(\"string\");",
              "    pm.expect(Number.isNaN(Date.parse(value))).to.eql(false);",
              "  });",
              "});",
              "pm.test(\"Only this offer's packages appear, with exact absolute API links\", () => {",
              "  const base = pm.variables.replaceIn(\"{{base_url}}\");",
              "  pm.expect(data.details).to.have.lengthOf(3);",
              "  const expected = fixture.details.map(d => ({id: d.id, url: base + \"/offerdetails/\" + d.id + \"/\"}));",
              "  pm.expect([...data.details].sort((a, b) => a.id - b.id)).to.eql(expected.sort((a, b) => a.id - b.id));",
              "});",
              "",
              "pm.test(\"Read requests preserve offer data and timestamps\", () => {",
              "  const before = JSON.parse(pm.collectionVariables.get(\"od_snapshot\"));",
              "  before.details.sort((a, b) => a.id - b.id);",
              "  const after = {...data, details: [...data.details].sort((a, b) => a.id - b.id)};",
              "  pm.expect(after).to.eql(before);",
              "});"
            ]
          }
        }
      ]
    }
